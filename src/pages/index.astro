---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Card from '../components/Card.astro';
import ProblemChooser from '../components/ProblemChooser.astro';
import Vignette from '../components/Vignette.astro';

const chooserOptions = [
  {
    target: 'v-reporting',
    label: 'Reporting takes too long',
    service: 'Data Platform Engineering',
  },
  {
    target: 'v-documents',
    label: 'Information is trapped in documents',
    service: 'AI on Your Own Data',
  },
  {
    target: 'v-manual',
    label: 'My team repeats manual work',
    service: 'AI Automation & Agents',
  },
  {
    target: 'v-disconnected',
    label: "Our systems don't connect",
    service: 'Integration & Internal Tools',
  },
  {
    target: 'v-disconnected',
    label: 'I need a custom internal tool',
    service: 'Integration & Internal Tools',
  },
];
---

<BaseLayout title="Mila Business Solutions LLC — AI automation on solid data foundations">
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow">AI automation &amp; data engineering</p>
      <h1>
        Most AI projects fail on the data, <span class="hero__accent"
          >not the model.</span
        >
      </h1>
      <p class="lead">
        We build AI automation that runs unattended — on top of database work
        solid enough to trust it. Two decades of enterprise data systems
        underneath, not a wrapper around an API.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="#start">
          See what we could improve
        </a>
        <a class="btn btn--secondary btn--lg" href="/demo/">
          Try the SQL review
        </a>
      </div>
      <p class="hero__note">
        The SQL review is a real tool, not a screenshot. Paste a slow query and
        judge the output yourself.
      </p>
    </div>
  </section>

  <!-- Problem chooser -->
  <Section
    id="start"
    sunken
    title="What are you trying to improve?"
    lead="Pick the one that sounds most like your week. Each shows a concrete example of the kind of system we build."
  >
    <ProblemChooser options={chooserOptions} />
  </Section>

  <!-- Vignettes -->
  <Section tight>
    <div class="vignettes">
      <Vignette
        id="v-reporting"
        title="A report that took four hours now takes seconds"
        problem="“Month-end reporting locks up the system and nobody can work.”"
        beforeLabel="The problem"
        afterLabel="What we build"
        service="Data Platform Engineering"
      >
        <div slot="before">
          <p class="v-text">
            A month-end revenue report runs as one enormous query against live
            operational tables. It scans everything, blocks writes while it
            runs, and finance reruns it three or four times a day during close.
          </p>
          <div class="v-metrics">
            <div class="v-metric v-metric--bad">
              <span class="v-metric__value">4h 10m</span>
              <span class="v-metric__label">Runtime</span>
            </div>
            <div class="v-metric v-metric--bad">
              <span class="v-metric__value">Blocked</span>
              <span class="v-metric__label">Order entry during run</span>
            </div>
            <div class="v-metric v-metric--bad">
              <span class="v-metric__value">Manual</span>
              <span class="v-metric__label">Kicked off by hand</span>
            </div>
          </div>
        </div>
        <div slot="after">
          <p class="v-text">
            The heavy aggregation moves to an incremental nightly job writing
            into a purpose-built reporting table. Finance reads a small, indexed
            result set. The live system stops carrying reporting load at all.
          </p>
          <div class="v-metrics">
            <div class="v-metric v-metric--good">
              <span class="v-metric__value">&lt; 2s</span>
              <span class="v-metric__label">Runtime</span>
            </div>
            <div class="v-metric v-metric--good">
              <span class="v-metric__value">None</span>
              <span class="v-metric__label">Impact on order entry</span>
            </div>
            <div class="v-metric v-metric--good">
              <span class="v-metric__value">02:00 nightly</span>
              <span class="v-metric__label">Runs itself</span>
            </div>
          </div>
        </div>
      </Vignette>

      <Vignette
        id="v-documents"
        title="Invoices become data you can actually query"
        problem="“Everything we need is in PDFs and nobody has time to key it in.”"
        beforeLabel="What arrives"
        afterLabel="What lands in your database"
        service="AI on Your Own Data"
      >
        <div slot="before">
          <div class="v-doc">
            <div class="v-doc__head">INVOICE — Northgate Supply Co.</div>
            {/* tabindex: this scrolls horizontally on narrow screens, and a
                scrollable region must be reachable by keyboard. */}
            <pre
              class="v-doc__body"
              tabindex="0"
              role="region"
              aria-label="Sample supplier invoice">Inv #  NG-88421
Date   14 Mar
Terms  Net 30

  2x  Valve assembly, 3/4"      412.00
  1x  Gasket kit (10pk)          58.50
      Freight                    31.20
                        TOTAL   501.70</pre>
          </div>
          <p class="v-text">
            Forty of these a week, from a dozen suppliers, each with a different
            layout. Someone re-types them into the ERP.
          </p>
        </div>
        <div slot="after">
          <div
            class="scroll-x"
            tabindex="0"
            role="region"
            aria-label="Extracted invoice line items"
          >
            <table class="v-table">
              <thead>
                <tr>
                  <th>invoice_no</th>
                  <th>supplier</th>
                  <th>line</th>
                  <th>description</th>
                  <th>qty</th>
                  <th>amount</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>NG-88421</td><td>Northgate Supply</td><td>1</td>
                  <td>Valve assembly, 3/4"</td><td>2</td><td>412.00</td>
                </tr>
                <tr>
                  <td>NG-88421</td><td>Northgate Supply</td><td>2</td>
                  <td>Gasket kit (10pk)</td><td>1</td><td>58.50</td>
                </tr>
                <tr>
                  <td>NG-88421</td><td>Northgate Supply</td><td>3</td>
                  <td>Freight</td><td>1</td><td>31.20</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="v-text">
            Extracted on arrival, validated against the purchase order, and
            written to real tables. Anything ambiguous is flagged for a human
            rather than guessed at — that distinction is the whole job.
          </p>
        </div>
      </Vignette>

      <Vignette
        id="v-manual"
        title="A weekly ritual that now runs itself"
        problem="“Every Monday someone spends half a day pulling the same numbers.”"
        beforeLabel="The Monday routine"
        afterLabel="The agent's run log"
        service="AI Automation & Agents"
      >
        <div slot="before">
          <ol class="v-steps">
            <li>Export three CSVs from the ops system</li>
            <li>Paste into the master workbook, fix the date columns</li>
            <li>Reconcile against last week, chase the two that don't match</li>
            <li>Rebuild the pivot, screenshot the chart</li>
            <li>Write the summary email</li>
            <li>Send, then answer the same four questions by reply</li>
          </ol>
          <p class="v-text">
            Roughly four hours. Breaks whenever a column moves. Lives entirely
            in one person's head.
          </p>
        </div>
        <div slot="after">
          <div class="v-log" tabindex="0" role="region" aria-label="Agent run log">
            <div class="v-log__line"><span class="v-log__ok">✓</span> 06:00:02 Pulled 3 sources — 14,206 rows</div>
            <div class="v-log__line"><span class="v-log__ok">✓</span> 06:00:19 Normalised dates, deduped 41 rows</div>
            <div class="v-log__line"><span class="v-log__ok">✓</span> 06:00:44 Reconciled vs. prior week</div>
            <div class="v-log__line"><span class="v-log__warn">!</span> 06:00:45 2 variances &gt; 5% — flagged, not guessed</div>
            <div class="v-log__line"><span class="v-log__ok">✓</span> 06:01:12 Summary drafted, chart rendered</div>
            <div class="v-log__line"><span class="v-log__ok">✓</span> 06:01:15 Sent to #ops-weekly</div>
          </div>
          <p class="v-text">
            Runs before anyone is awake. The two variances still need a human —
            so it says so, rather than inventing an explanation.
          </p>
        </div>
      </Vignette>

      <Vignette
        id="v-disconnected"
        title="One dashboard instead of five logins"
        problem="“The answer exists, but it's spread across systems that don't talk.”"
        beforeLabel="Today"
        afterLabel="After"
        service="Integration & Internal Tools"
      >
        <div slot="before">
          <div class="v-systems">
            <div class="v-system">CRM<span>Customer + contract</span></div>
            <div class="v-system">Scheduling<span>Who's on site</span></div>
            <div class="v-system">Accounting<span>What was billed</span></div>
            <div class="v-system">Inventory<span>What was used</span></div>
            <div class="v-system">Spreadsheet<span>The bit nobody automated</span></div>
          </div>
          <p class="v-text">
            Answering “are we making money on this account?” means five logins
            and a manual reconciliation nobody trusts.
          </p>
        </div>
        <div slot="after">
          <div class="v-dash">
            <div class="v-dash__row v-dash__row--head">
              <span>Account</span><span>Revenue</span><span>Cost</span><span>Margin</span>
            </div>
            <div class="v-dash__row">
              <span>Harborview Facilities</span><span>$48,200</span><span>$31,900</span>
              <span class="v-dash__good">33.8%</span>
            </div>
            <div class="v-dash__row">
              <span>Weston Retail Group</span><span>$22,750</span><span>$21,010</span>
              <span class="v-dash__bad">7.6%</span>
            </div>
            <div class="v-dash__row">
              <span>Pinehurst Medical</span><span>$61,400</span><span>$38,600</span>
              <span class="v-dash__good">37.1%</span>
            </div>
          </div>
          <p class="v-text">
            One read-only view, refreshed hourly, sourced from all five. No
            system gets replaced — they just stop being islands.
          </p>
        </div>
      </Vignette>
    </div>
  </Section>

  <!-- Services summary -->
  <Section
    sunken
    title="What we do"
    lead="Four practice areas. The last one is the foundation the first three depend on."
  >
    <div class="grid grid--2">
      <Card title="AI Automation & Agents" class="reveal">
        Scheduled agents and workflows that run unattended — and know when to
        escalate to a human instead of guessing.
      </Card>
      <Card title="AI on Your Own Data" class="reveal">
        Document and transcript intelligence, retrieval over your own content,
        and structured extraction that lands in real database tables.
      </Card>
      <Card title="Data Platform Engineering" class="reveal">
        Schema design, query optimisation, migrations, and reporting layers.
        The unglamorous work that decides whether the rest is possible.
      </Card>
      <Card title="Integration & Internal Tools" class="reveal">
        Dashboards, APIs, and internal applications that connect systems which
        were never designed to talk to each other.
      </Card>
    </div>
    <p style="margin-top:var(--space-6);">
      <a href="/services/">Full breakdown of how we work &rarr;</a>
    </p>
  </Section>

  <!-- Closing CTA -->
  <Section narrow center title="Start with the smallest real problem">
    <p class="lead" style="margin-inline:auto; text-align:center;">
      The fastest way to find out whether we're useful to you is to hand us
      something specific and annoying. Tell us what's slow, manual, or
      unreliable.
    </p>
    <p style="text-align:center; margin-top:var(--space-6);">
      <a class="btn btn--primary btn--lg" href="/contact/">Describe your problem</a>
    </p>
  </Section>
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-9), 8vw, var(--space-11));
    border-bottom: 1px solid var(--c-border);
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -40% -10% auto -10%;
    height: 130%;
    background:
      radial-gradient(50% 55% at 22% 30%, var(--hero-glow-a), transparent 70%),
      radial-gradient(45% 50% at 78% 20%, var(--hero-glow-b), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 46rem;
  }

  .hero h1 {
    margin-top: var(--space-4);
  }

  .hero__accent {
    background: linear-gradient(
      100deg,
      var(--c-accent),
      color-mix(in srgb, var(--c-accent) 45%, var(--c-fg))
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero .lead {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }

  .hero__note {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--c-fg-subtle);
  }

  /* ---- Vignettes ---- */
  .vignettes {
    display: grid;
    gap: var(--space-5);
  }

  .v-text {
    font-size: var(--text-sm);
    color: var(--c-fg-muted);
    max-width: none;
  }

  .v-text + .v-text,
  .v-metrics + .v-text,
  .scroll-x + .v-text,
  .v-log + .v-text,
  .v-systems + .v-text,
  .v-dash + .v-text,
  .v-steps + .v-text {
    margin-top: var(--space-4);
  }

  .v-metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .v-metric {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid var(--c-border);
    background: var(--c-bg-inset);
  }

  .v-metric--bad {
    border-left: 3px solid var(--c-danger);
  }
  .v-metric--good {
    border-left: 3px solid var(--c-ok);
  }

  .v-metric__value {
    display: block;
    font-size: var(--text-xl);
    font-weight: 680;
    letter-spacing: -0.02em;
  }

  .v-metric__label {
    display: block;
    font-size: var(--text-xs);
    color: var(--c-fg-subtle);
    margin-top: var(--space-1);
  }

  /* Document */
  .v-doc {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--c-bg-inset);
    max-width: 30rem;
  }

  .v-doc__head {
    padding: var(--space-3) var(--space-4);
    background: var(--c-bg-sunken);
    border-bottom: 1px solid var(--c-border);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.04em;
    color: var(--c-fg-muted);
  }

  .v-doc__body {
    margin: 0;
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.7;
    color: var(--c-fg-muted);
    overflow-x: auto;
  }

  /* Table */
  .v-table {
    border-collapse: collapse;
    width: 100%;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    min-width: 34rem;
  }

  .v-table th,
  .v-table td {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--c-border);
    white-space: nowrap;
  }

  .v-table th {
    color: var(--c-fg-subtle);
    font-weight: 600;
    border-bottom-color: var(--c-border-strong);
  }

  .v-table td {
    color: var(--c-fg-muted);
  }

  /* Steps */
  .v-steps {
    margin: 0;
    padding-left: var(--space-5);
    font-size: var(--text-sm);
    color: var(--c-fg-muted);
    display: grid;
    gap: var(--space-2);
  }

  /* Log */
  .v-log {
    background: var(--c-code-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.9;
    color: #cbd5e1;
    overflow-x: auto;
  }

  .v-log__line {
    white-space: nowrap;
  }

  .v-log__ok {
    color: #34d399;
    margin-right: 0.5rem;
  }
  .v-log__warn {
    color: #fbbf24;
    margin-right: 0.5rem;
  }

  /* Systems */
  .v-systems {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    gap: var(--space-2);
  }

  .v-system {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3);
    border: 1px dashed var(--c-border-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .v-system span {
    font-size: var(--text-xs);
    font-weight: 400;
    color: var(--c-fg-subtle);
  }

  /* Dashboard */
  .v-dash {
    border: 1px solid var(--c-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    font-size: var(--text-sm);
  }

  .v-dash__row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--c-border);
  }

  .v-dash__row:last-child {
    border-bottom: none;
  }

  .v-dash__row--head {
    background: var(--c-bg-inset);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--c-fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .v-dash__row span:not(:first-child) {
    text-align: right;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .v-dash__good {
    color: var(--c-ok);
    font-weight: 650;
  }
  .v-dash__bad {
    color: var(--c-danger);
    font-weight: 650;
  }

  @media (max-width: 560px) {
    .v-dash__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
